{
  "name": "nextjs-starter",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "bun lint && bun typecheck && bun format:check && bun knip && bun lint:spell",
    "clean": "rm -rf .next",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip-bun",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "lint:spell": "cspell .",
    "prepare": "lefthook install",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@nelsonlaidev/eslint-config": "4.0.0",
    "@nelsonlaidev/prettier-config": "0.2.1",
    "@nelsonlaidev/typescript-config": "1.2.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "9.7.0",
    "eslint": "10.1.0",
    "knip": "6.1.1",
    "lefthook": "2.1.4",
    "postcss-load-config": "6.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.2",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  }
}
